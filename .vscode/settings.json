{
	"nrf-connect.applications": [
		"${workspaceFolder}/firmware/korora",
		"${workspaceFolder}/firmware/galapagos",
		"${workspaceFolder}/sandbox/01-blink/nordic",
		"${workspaceFolder}/sandbox/02-ble/peripheral",
		"${workspaceFolder}/sandbox/03-protocol/bridge"
	],

	// clangd finds each project's compile_commands.json on its own and picks
	// the right one PER FILE, so there is no configuration to switch between.
	// The Microsoft C/C++ extension's parser must be off or the two fight.
	"C_Cpp.intelliSenseEngine": "disabled",
	"clangd.path": "C:/Users/Stefan Rogers/AppData/Local/clangd/clangd_18.1.3/bin/clangd.exe",
	// Inlay hints collapse into noise inside macro expansions such as
	// BT_UUID_INIT_128. Hold Ctrl+Alt to show them when they are useful.
	"editor.inlayHints.enabled": "offUnlessPressed",
	"clangd.arguments": [
		"--background-index",
		"--header-insertion=never"
	],
	"cmake.ignoreCMakeListsMissing": true
}
