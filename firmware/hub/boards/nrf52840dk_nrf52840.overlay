#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    zephyr,user {
        sync-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;

        /*
         * The Grove RS-485 breakout used on the breadboard rig switches
         * direction automatically, so no DE line is wired. src/rs485_bus.cpp
         * requires this property unconditionally, so point it at a free,
         * unconnected DK pin. P1.12 is used by nothing else on this board.
         */
        rs485-dir-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
    };
};

&pinctrl {
    node_uart1_default: node_uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 27)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 26)>;
            bias-pull-up;
        };
    };

    node_uart1_sleep: node_uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 27)>,
                    <NRF_PSEL(UART_RX, 0, 26)>;
            low-power-enable;
        };
    };

    hub_i2c1_default: hub_i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 30)>,
                    <NRF_PSEL(TWIM_SCL, 0, 31)>;
        };
    };

    hub_i2c1_sleep: hub_i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 30)>,
                    <NRF_PSEL(TWIM_SCL, 0, 31)>;
            low-power-enable;
        };
    };
};

&uart1 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <460800>;
    pinctrl-0 = <&node_uart1_default>;
    pinctrl-1 = <&node_uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * The DK's normal i2c0 mapping uses P0.26/P0.27, which are already the
 * working node UART pins above. Keep that controller disabled.
 */
&i2c0 {
    status = "disabled";
};

/* i2c1 and spi1 share the same nRF peripheral instance on this DK. */
&spi1 {
    status = "disabled";
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&hub_i2c1_default>;
    pinctrl-1 = <&hub_i2c1_sleep>;
    pinctrl-names = "default", "sleep";
};

&timer2 {
    status = "okay";
};

&timer3 {
    status = "disabled";
};

&rtc2 {
    status = "okay";
};
