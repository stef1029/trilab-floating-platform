# Tells clangd which compilation database to use for files in this app.
# Zephyr nests it under the build directory, deeper than clangd searches on
# its own. Regenerated by every build -- no maintenance needed.
#
# To index a different board, point this at that build directory instead.
CompileFlags:
  CompilationDatabase: build-dk/korora

  # The database records GCC invocations. These flags have no clang
  # equivalent and would otherwise show up as errors in the editor.
  Remove:
    - -fno-printf-return-value
    - -fno-reorder-functions
    - -mfp16-format=*
    - -mtp=*
    - --param=*
  # The Zephyr SDK ships GCC's libstdc++ headers, but clang looks for libc++
  # by default and fails on <cstddef>. Point it at the real location.
  Add:
    - -IC:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/arm-zephyr-eabi/include/c++/14.3.0
    - -IC:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/arm-zephyr-eabi/include/c++/14.3.0/arm-zephyr-eabi
    - -IC:/ncs/toolchains/4f5b6ad6dd/opt/zephyr-sdk/gnu/arm-zephyr-eabi/arm-zephyr-eabi/include/c++/14.3.0/backward
