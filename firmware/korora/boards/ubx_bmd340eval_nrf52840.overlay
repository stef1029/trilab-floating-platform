#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
        zephyr,uart-mcumgr = &cdc_acm_uart0;
    };

    zephyr,user {
        /* SN65HVD75 RS485 direction */
        rs485-dir-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;

        /* Sync output */
        sync-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        sync-dir-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;

        /* MMC5983MA interrupt */
        imu-int-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;

        /* nPM1300 interrupt */
        pmic-int-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;

    };

    /**
     * These belong to the physical BMD-340-EVAL board,
     * not your Floating Hub.
     */
    leds {
        status = "disabled";
    };

    pwmleds {
        status = "disabled";
    };

    buttons {
        status = "disabled";
    };
};

&pinctrl {
    /**
     * RS485 UART
     *
     * P0.19 -> RS485_TX
     * P0.17 <- RS485_RX
     */
    floating_uart1_default: floating_uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 19)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 17)>;
            bias-pull-up;
        };
    };

    floating_uart1_sleep: floating_uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 19)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
            low-power-enable;
        };
    };

    /**
     * HOST I2C
     *
     * P0.13 -> HOST_SDA
     * P0.14 -> HOST_SCL
     */
    floating_i2c1_default: floating_i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>,
                    <NRF_PSEL(TWIM_SCL, 0, 14)>;
        };
    };

    floating_i2c1_sleep: floating_i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>,
                    <NRF_PSEL(TWIM_SCL, 0, 14)>;
            low-power-enable;
        };
    };
};

/**
 * Hardware UART -> RS485 transceiver
 */
&uart1 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <460800>;
    pinctrl-0 = <&floating_uart1_default>;
    pinctrl-1 = <&floating_uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/**
 * HOST I2C bus
 *
 * nPM1300 + magnetometer are physically on this bus.
 */
&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&floating_i2c1_default>;
    pinctrl-1 = <&floating_i2c1_sleep>;
    pinctrl-names = "default", "sleep";
};

/**
 * Peripheral conflicts inherited from BMD-340-EVAL.
 */
&uart0 {
    status = "disabled";
};
&i2c0 {
    status = "disabled";
};
&spi1 {
    status = "disabled";
};
&qspi {
    status = "disabled";
};
&pwm0 {
    status = "disabled";
};
&spi3 {
    status = "disabled";
};

/**
 * Native USB device controller.
 *
 * D+ / D- are dedicated nRF52840 pins, so no pinctrl is needed.
 */
&zephyr_udc0 {
    status = "okay";

    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&timer2 {
    status = "okay";
};
&timer3 {
    status = "disabled";
};
&rtc2 {
    status = "okay";
};
