# Tells clangd which compilation database to use for files in this app.
# Zephyr nests it under the build directory, deeper than clangd searches on
# its own. Regenerated by every build -- no maintenance needed.
#
# To index a different board, point this at that build directory instead.
CompileFlags:
  CompilationDatabase: build-dk/peripheral

  # The database records GCC invocations. These flags have no clang
  # equivalent and would otherwise show up as errors in the editor.
  Remove:
    - -fno-printf-return-value
    - -fno-reorder-functions
    - -mfp16-format=*
    - -mtp=*
    - --param=*
