#!/usr/bin/env sh
# Build (and optionally flash) a sandbox project.
#
#   ./blink nordic            build blink-nordic for the nRF52840 DK
#   ./blink nordic flash      ...and flash it
#   ./blink stm32             build blink-stm32 for the NUCLEO-G071RB
#   ./blink stm32 flash       ...and flash it
#   ./blink stm32 monitor     open the serial console
#   ./blink stm32 index       regenerate compile_commands.json for the editor
#   ./blink ble               build the BLE peripheral for the nRF52840 DK
#   ./blink ble flash         ...and flash it
#   ./blink bridge [flash]    BLE<->UART bridge, real Transport v1
#   ./blink fairy  [flash]    the Nucleo end of that link
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NCS_VERSION=${NCS_VERSION:-v3.4.1}
NRFUTIL=${NRFUTIL:-/c/ncs/tools/nrfutil.exe}
PIO=${PIO:-$HOME/.platformio/penv/Scripts/pio.exe}

target=${1:-}
action=${2:-build}

case "$target" in
nordic|ble|bridge)
    case "$target" in
      ble)    app=ble-led ;;
      bridge) app=bridge ;;
      *)      app=blink-nordic ;;
    esac
    ZEPHYR_BASE="C:/ncs/${NCS_VERSION}/zephyr"; export ZEPHYR_BASE
    cd "$here"
    case "$action" in
    build) cmd="west build -p always -b nrf52840dk/nrf52840 $app --build-dir $app/build-dk" ;;
    flash) cmd="west flash --build-dir $app/build-dk --dev-id 1050230658" ;;
    *) echo "unknown action: $action" >&2; exit 2 ;;
    esac
    exec "$NRFUTIL" sdk-manager toolchain launch --ncs-version "$NCS_VERSION" -- $cmd
    ;;
fairy)
    case "$action" in
    build)   exec "$PIO" run -d "$here/fairy-lite" ;;
    flash)   exec "$PIO" run -d "$here/fairy-lite" -t upload ;;
    monitor) exec "$PIO" device monitor -b 115200 ;;
    index)   exec "$PIO" run -d "$here/fairy-lite" -t compiledb ;;
    *) echo "unknown action: $action" >&2; exit 2 ;;
    esac
    ;;
stm32)
    case "$action" in
    build)   exec "$PIO" run -d "$here/blink-stm32" ;;
    index)   exec "$PIO" run -d "$here/blink-stm32" -t compiledb ;;
    flash)   exec "$PIO" run -d "$here/blink-stm32" -t upload ;;
    monitor) exec "$PIO" device monitor -b 115200 ;;
    *) echo "unknown action: $action" >&2; exit 2 ;;
    esac
    ;;
*)
    echo "usage: $0 {nordic|ble|bridge|fairy|stm32} [build|flash|monitor|index]" >&2
    exit 2
    ;;
esac
