#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * Link to the Fairy, now through an RS485 transceiver instead of a bare
 * wire. Same pins the real Korora prototype uses:
 *
 *   P0.27 -> DI    transceiver data in   (we transmit)
 *   P0.26 <- RO    transceiver data out  (we receive)
 *   P1.12 -> DE//RE  direction: HIGH = drive the bus, LOW = listen
 */
&pinctrl {
    bridge_uart1_default: bridge_uart1_default {
        group1 { psels = <NRF_PSEL(UART_TX, 0, 27)>; };
        group2 { psels = <NRF_PSEL(UART_RX, 0, 26)>; bias-pull-up; };
    };
    bridge_uart1_sleep: bridge_uart1_sleep {
        group1 { psels = <NRF_PSEL(UART_TX, 0, 27)>,
                         <NRF_PSEL(UART_RX, 0, 26)>;
                 low-power-enable; };
    };
};

&uart1 {
    status = "okay";
    current-speed = <460800>;
    pinctrl-0 = <&bridge_uart1_default>;
    pinctrl-1 = <&bridge_uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * The direction pin is not a UART property, so it does not belong under
 * &uart1. zephyr,user is the conventional home for application-level
 * devicetree entries -- the real Korora declares RS485_DIR the same way.
 */
/ {
    zephyr,user {
        rs485-dir-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
    };
};

/* i2c0 shares pins with uart1's defaults on this DK. */
&i2c0 { status = "disabled"; };
