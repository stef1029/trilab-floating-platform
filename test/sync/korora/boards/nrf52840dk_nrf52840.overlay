#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    zephyr,user {
        /* Korora hardware synchronization output to Fairy. */
        sync-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;

        /* Existing shared external event input. */
        event-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;

        /* Galapagos scheduled TTL output is wired here. */
        ttl-input-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
    };
};

&timer2 {
    status = "okay";
};

/* Phase mirror used only for the new TTL hardware capture. */
&timer3 {
    status = "okay";
};

&rtc2 {
    status = "okay";
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};
